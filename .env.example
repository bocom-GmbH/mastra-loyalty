# --- Mastra server ---
PORT=4111
NODE_ENV=production

# --- Database ---
# No Coolify: crie um serviço "PostgreSQL" no mesmo project e use o hostname interno.
# Ex.: postgresql://mastra:senha@postgres-xyz:5432/mastra
DATABASE_URL=postgresql://mastra:change-me@postgres:5432/mastra
# Em provedores managed (Neon, Supabase) use true. Em Postgres interno do Coolify: false.
DATABASE_SSL=false

# --- LLM ---
OPENAI_API_KEY=sk-...

# --- Studio (Traefik Basic Auth) ---
# Gere com:  htpasswd -nbB admin 'sua-senha' | sed 's/\$/\$\$/g'
# (No painel do Coolify NÃO duplique o $ — só duplique se editar o compose direto.)
STUDIO_BASIC_AUTH=admin:$$apr1$$exemplo$$hashaqui
