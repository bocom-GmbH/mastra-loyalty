FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache dumb-init && \
    addgroup -S mastra && adduser -S mastra -G mastra && \
    npm install -g mastra@^1.9.1

USER mastra
EXPOSE 3000

ENV STUDIO_PORT=3000
ENV STUDIO_SERVER_HOST=mastra
ENV STUDIO_SERVER_PORT=4111
ENV STUDIO_SERVER_PROTOCOL=http

ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "-c", "mastra studio --port $STUDIO_PORT --server-host $STUDIO_SERVER_HOST --server-port $STUDIO_SERVER_PORT --server-protocol $STUDIO_SERVER_PROTOCOL"]
