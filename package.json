{
  "name": "mastra-coolify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build --studio && npm run build:seed",
    "build:seed": "esbuild src/seed-editor.ts --bundle --platform=node --format=esm --target=node22 --outfile=.mastra/output/seed.mjs --packages=external --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "start": "mastra start",
    "studio": "mastra studio",
    "seed": "tsx src/seed-editor.ts",
    "seed:prod": "node .mastra/output/seed.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@mastra/core": "^1.33.1",
    "@mastra/editor": "^0.8.0",
    "@mastra/loggers": "^1.1.1",
    "@mastra/pg": "^1.10.1",
    "@types/pg": "^8.20.0",
    "mastra": "^1.9.2",
    "pg": "^8.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.22.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
